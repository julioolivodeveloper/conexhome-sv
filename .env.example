# ─────────────────────────────────────────────────────────────────────────────
# ConexHome SV — Variables de entorno
# Copia este archivo como .env.local y completa los valores reales.
# NUNCA subas .env.local a GitHub.
# ─────────────────────────────────────────────────────────────────────────────

# ── Sitio ─────────────────────────────────────────────────────────────────────
# Pública — usada para URLs canónicas, Open Graph y Sitemap
NEXT_PUBLIC_SITE_URL=https://conexhomesv.com

# Pública — nombre de la plataforma mostrado en UI y metadatos
NEXT_PUBLIC_SITE_NAME=ConexHome SV

# ── Supabase ──────────────────────────────────────────────────────────────────
# Pública — URL del proyecto Supabase (segura para el browser)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Pública — clave anónima de Supabase (segura para el browser, respaldada por RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# PRIVADA — clave de servicio de Supabase
# ⚠️  NUNCA usar con prefijo NEXT_PUBLIC_
# ⚠️  Solo usar en Server Actions, API Routes o scripts de servidor
# ⚠️  Con esta clave se omite RLS — tratar como contraseña root
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Mapa ──────────────────────────────────────────────────────────────────────
# Pública — URL del estilo visual del mapa (MapLibre GL JS)
# Por defecto usa tiles gratuitos de OpenStreetMap vía demotiles.
# Se puede cambiar a Maptiler, Mapbox u otro proveedor sin modificar la app.
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# Pública — URL base para tiles (si el estilo los usa por separado)
NEXT_PUBLIC_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# ── Plataforma ────────────────────────────────────────────────────────────────
# Pública — Número de WhatsApp de ConexHome SV para soporte (formato internacional sin +)
NEXT_PUBLIC_PLATFORM_WHATSAPP=50300000000
